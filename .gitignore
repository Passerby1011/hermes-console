# ── 构建产物：由 scripts/build.mjs 生成，禁止手改
#    src/main.js ──esbuild──▶ dashboard/dist/index.js ──逐字节镜像──▶ desktop/plugin.js
#    复现：node plugins/hermes-console/scripts/build.mjs（esbuild 输出无时间戳，同输入同字节）
#    验收纪律：产物身份 = 「源码 commit + 一次确定性构建」，不再用写死的哈希当基线。
#
#    ⚠️ 2026-11-04 起**产物入库**（原先忽略）：
#    manifest.json 的 entry 指向 dist/index.js，产物不入库 ⇒ 新克隆的仓库装上去面板白屏。
#    为了「clone 即可安装」，产物必须跟着源码走。改完 src/ 后务必重跑 build.mjs 并一并提交，
#    否则仓库里的产物会落后于源码 —— 这正是「面板和后端对不上」的老病根。
#    （desktop/plugin.js 与 dist/index.js 是同字节镜像，同样入库。）

# ── 运行时数据与本地状态（不是源码）
data/
_sandbox/

# ── 探针/验收证据（属看板任务产物，已在 kanban attachments 留档，不入库）
scripts/_probe_out/
scripts/.probe_out*
probe_*.json
AUTOGROUP-AUDIT-*.md
dashboard/_deleted_*/

# ── Python 缓存
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ── 依赖与日志
node_modules/
*.log

# ── 凭据与本地配置（若将来出现，一律不入库）
.env
.env.*
*.key
*.pem
*.p12
*.pfx
auth.json
**/auth.json
state.json
**/state.json

# ── Hermes 本地状态
.hermes/

# ── 执行 lane 的工作树（每个 worktree 都是独立的 git 仓库）
#    误加进索引会变成 gitlink（submodule 占位），克隆方拿到的是空目录。
#    2026-11-04 踩过一次：git add -A 把 4 个 worktree 当子模块加进去，
#    仓库体积从 8.6M 涨到 48M。这条必须留着。
.worktrees/
